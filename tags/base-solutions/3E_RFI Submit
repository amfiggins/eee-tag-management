<script>
// Script Name: 3E_RFI Submit
// Author: Anthony Figgins
// Description: Handles Marketo RFI form submission and 123FormBuilder form submission, pushes event to dataLayer, and manages redirect.
// Version: 1.3.1
// Date Updated: 2025-12-15
// Dependencies: 3E Config, Marketo Forms2

  (function() {
    // Check for hardcoded RFI submit script (minified inline script)
    var hasHardcodedRFI = false;
    var scripts = document.getElementsByTagName('script');
    
    for (var i = 0; i < scripts.length; i++) {
      var scriptText = scripts[i].textContent || '';
      
      // Look for unique identifier from the minified combined script
      // This script uses google_tag_manager["rm"]["227984193"](69) pattern
      if (scriptText.indexOf('google_tag_manager["rm"]["227984193"]') !== -1) {
        hasHardcodedRFI = true;
        console.log('[3E_RFI Submit] Hardcoded combined script detected (google_tag_manager pattern)');
        break;
      }
      
      // Also check for scripts that push rfi_submission but don't have our GTM identifiers
      if (scriptText.indexOf('dataLayer.push({event:"rfi_submission"})') !== -1 || 
          scriptText.indexOf("dataLayer.push({event:'rfi_submission'})") !== -1 ||
          scriptText.indexOf('dataLayer.push({"event":"rfi_submission"})') !== -1 ||
          scriptText.indexOf("dataLayer.push({'event':'rfi_submission'})") !== -1) {
        // Check if it's NOT our GTM script (which has unique identifiers)
        if (scriptText.indexOf('[3E_RFI Submit]') === -1 && 
            scriptText.indexOf('{{3E config}}') === -1 &&
            scriptText.indexOf('checkMktoForm(attempts)') === -1 &&
            scriptText.indexOf('function checkMktoForm') === -1) {
          hasHardcodedRFI = true;
          console.log('[3E_RFI Submit] Hardcoded RFI submit script detected (pushes rfi_submission without GTM identifiers)');
          break;
        }
      }
    }
    
    if (hasHardcodedRFI) {
      console.log('[3E_RFI Submit] Skipping execution - hardcoded script found');
      return;
    }

  // Get debug mode from 3E Config (shared for both form types)
  var CFG;
  try { 
    CFG = {{3E config}}; 
  } catch(e) { 
    CFG = {}; 
  }
  var DEBUG = CFG && CFG.debugMode === 'true';

  // Ensure dataLayer exists
  window.dataLayer = window.dataLayer || [];

  // Log script name and version on load (only in debug mode)
  if (DEBUG) {
    console.log('[3E_RFI Submit] v1.3.1');
  }

  // Function to push rfi_submission event (shared by both form types)
  function pushRFISubmissionEvent() {
    window.dataLayer.push({'event': 'rfi_submission'});
    if (DEBUG) {
      console.log('[3E_RFI Submit] Pushed rfi_submission event to dataLayer');
    }
  }

  // Marketo Form Handler
  (function checkMktoForm(attempts) {
    // Check if MktoForms2 is available
    if (typeof MktoForms2 !== 'undefined') {
      MktoForms2.whenReady(function(form) {
        if (DEBUG) {
          console.log('[3E_RFI Submit] Marketo form detected and ready');
        }
        form.onSuccess(function(values, followUpUrl) {
          // Push the event to the dataLayer
          pushRFISubmissionEvent();

          // Redirect to the Thank You page
          if (followUpUrl) {
            window.location.href = followUpUrl;
          }

          // Prevent the default Marketo redirect behavior
          return false;
        });
      });
    } else if (attempts < 10) {
      // Retry after 1 second if MktoForms2 is not available and we haven't hit the max attempts
      setTimeout(function() {
        checkMktoForm(attempts + 1);
      }, 1000);
    } else {
      // If MktoForms2 is not available after 10 attempts, log an error (only in debug mode)
      if (DEBUG) {
        console.log('[3E_RFI Submit] MktoForms2 is not defined. Marketo forms failed to load after 10 attempts.');
      }
    }
  })(0); // Start with 0 attempts

  // 123FormBuilder trusted origins for postMessage validation
  var TRUSTED_123FORMBUILDER_ORIGINS = {
    'https://form.123formbuilder.com': true,
    'https://www.123formbuilder.com': true,
    'https://123formbuilder.com': true,
    'http://form.123formbuilder.com': true
  };

  // Function to validate postMessage origin
  function isTrusted123FormBuilderOrigin(origin) {
    if (!origin) return false;
    return TRUSTED_123FORMBUILDER_ORIGINS[origin] === true;
  }

  // Set up postMessage listener for cross-origin 123FormBuilder iframes (only set up once)
  var postMessageListenerSetup = false;
  function setup123FormBuilderPostMessageListener() {
    if (postMessageListenerSetup) return;
    postMessageListenerSetup = true;
    
    window.addEventListener('message', function(event) {
      // Validate origin for security - only accept messages from trusted 123FormBuilder domains
      if (!isTrusted123FormBuilderOrigin(event.origin)) {
        if (DEBUG) {
          console.log('[3E_RFI Submit] Rejected postMessage from untrusted origin:', event.origin);
        }
        return;
      }
      
      // Check if message indicates form success
      if (event.data && (event.data.type === '123formbuilder-success' || 
                         event.data.event === 'formSuccess' ||
                         event.data.formSuccess === true)) {
        if (DEBUG) {
          console.log('[3E_RFI Submit] Received postMessage from trusted 123FormBuilder iframe:', event.origin);
        }
        pushRFISubmissionEvent();
      }
    }, false);
    
    if (DEBUG) {
      console.log('[3E_RFI Submit] PostMessage listener set up for 123FormBuilder cross-origin iframes');
    }
  }

  // 123FormBuilder Form Handler
  (function check123FormBuilder(attempts) {
    try {
      // Look for 123FormBuilder form elements (typically have IDs like #cf_1, #cf_2, etc.)
      var form123Elements = document.querySelectorAll('[id^="cf_"]');
      
      if (form123Elements.length > 0) {
        if (DEBUG) {
          console.log('[3E_RFI Submit] Found', form123Elements.length, 'potential 123FormBuilder form(s)');
        }
        
        // Attach success event listeners to each form
        for (var i = 0; i < form123Elements.length; i++) {
          var formElement = form123Elements[i];
          
          // Listen for success event (123FormBuilder fires this on successful submission)
          formElement.addEventListener('success', function(e) {
            if (DEBUG) {
              console.log('[3E_RFI Submit] 123FormBuilder form success event detected');
            }
            // Push the event to the dataLayer
            pushRFISubmissionEvent();
          }, false);
          
          // Also listen for custom events that might be fired
          // Some 123FormBuilder implementations use different event names
          formElement.addEventListener('formSuccess', function(e) {
            if (DEBUG) {
              console.log('[3E_RFI Submit] 123FormBuilder formSuccess event detected');
            }
            pushRFISubmissionEvent();
          }, false);
          
          if (DEBUG) {
            console.log('[3E_RFI Submit] Attached event listeners to 123FormBuilder form:', formElement.id);
          }
        }
      } else {
        // Check for 123FormBuilder forms in iframes (cross-origin handling)
        var iframes = document.querySelectorAll('iframe');
        var form123FoundInIframe = false;
        
        for (var j = 0; j < iframes.length; j++) {
          var iframe = iframes[j];
          var iframeSrc = iframe.src || '';
          
          // Check if iframe contains 123FormBuilder (common patterns)
          if (iframeSrc.indexOf('123formbuilder.com') !== -1 || 
              iframeSrc.indexOf('123formbuilder') !== -1 ||
              iframe.id && iframe.id.indexOf('cf_') !== -1) {
            form123FoundInIframe = true;
            if (DEBUG) {
              console.log('[3E_RFI Submit] Found 123FormBuilder iframe:', iframe.src || iframe.id);
              console.log('[3E_RFI Submit] Setting up postMessage listener for cross-origin communication');
            }
            
            // For cross-origin iframes, we can only use postMessage
            // Set up the postMessage listener (only once, shared for all iframes)
            setup123FormBuilderPostMessageListener();
          }
        }
        
        // If no forms found and we haven't hit max attempts, retry
        if (form123Elements.length === 0 && !form123FoundInIframe && attempts < 10) {
          setTimeout(function() {
            check123FormBuilder(attempts + 1);
          }, 1000);
        } else if (attempts >= 10 && form123Elements.length === 0 && !form123FoundInIframe) {
          if (DEBUG) {
            console.log('[3E_RFI Submit] 123FormBuilder forms not found after 10 attempts');
          }
        }
      }
    } catch (e) {
      if (DEBUG) {
        console.error('[3E_RFI Submit] Error checking for 123FormBuilder forms:', e);
      }
      // Retry if we haven't hit max attempts
      if (attempts < 10) {
        setTimeout(function() {
          check123FormBuilder(attempts + 1);
        }, 1000);
      }
    }
  })(0); // Start with 0 attempts
  })(); // Close outer detection wrapper
</script>