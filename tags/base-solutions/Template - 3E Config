// 3E Config v2.2 - variable template (sandbox-safe)
const log = require('logToConsole');

function pick(v, def){ return (v === undefined || v === null || v === '') ? def : v; }
function toStr(v){ return (v === undefined || v === null) ? '' : '' + v; }
function flag(v, defBool){ // returns "true"/"false"
  var def = defBool ? 'true' : 'false';
  return toStr(pick(v, def)).toLowerCase();
}

const cfg = {
  baseUrl:            toStr(pick(data.baseUrl, '')),
  munchkinId:         toStr(pick(data.munchkinId, '')),
  wsInfo:             toStr(pick(data.wsInfo, '')),
  debugMode:          flag(data.debugMode, false),

  blindFormId:        toStr(pick(data.blindFormId, '')),
  leadFormId:         toStr(pick(data.leadFormId, '')),

  chatBotProdId:      toStr(pick(data.chatBotProdId, '')),
  chatBotDevId:       toStr(pick(data.chatBotDevId, '')),
  chatBotEnvironment: toStr(pick(data.chatBotEnvironment, 'disabled')), // 'disabled', 'dev', 'prod'
  popupTag:           toStr(pick(data.popupTag, '')), // Pop-up Script (vendor snippet)
  popupEnvironment:   toStr(pick(data.popupEnvironment, 'disabled')), // 'disabled', 'enabled'
  
  // New script configurations
  faviconUrl:         toStr(pick(data.faviconUrl, '')), // Favicon URL for injection
  cloudflareToken:    toStr(pick(data.cloudflareToken, '271854501d8743cfb7cc749ee8f2dde0')), // Cloudflare analytics token

  // validation toggles
  formNameValidation:       flag(data.formNameValidation, true),
  formMathValidation:       flag(data.formMathValidation, true),
  formPreventDefaultName:   flag(data.formPreventDefaultName, true),
  formIpBlocking:           flag(data.formIpBlocking, false),
  formEduValidation:        flag(data.formEduValidation, false)
};

// if (cfg.debugMode === 'true') { log('[3E Config]', cfg); }

return cfg;