<script>
// Script Name: 3E_Form Validation
// Author: Anthony Figgins
// Description: Advanced Marketo form validation with 3E config integration, including name validation, EDU email validation, IP blocking, math questions, and comprehensive debugging.
// Version: 7.3.1
// Date Updated: 2025-12-05
// Changes: Enhanced hidden form detection to check form element data attributes for more reliable identification

(function() {
    // Check for the original hardcoded script by searching for "custom-marketo-validation" identifier
    var hasCustomValidation = false;
    var scripts = document.getElementsByTagName('script');
    
    for (var i = 0; i < scripts.length; i++) {
        var scriptSrc = scripts[i].src || '';
        var scriptText = scripts[i].textContent || '';
        
        // Look for the custom-marketo-validation identifier in the src
        if (scriptSrc.indexOf('custom-marketo-validation') !== -1) {
            // Check if it has "" before and after (indicating it's commented out/invalid)
            var scriptSrcLength = scriptSrc.length;
            var hasLeadingQuotes = scriptSrc.charAt(0) === '"' && scriptSrc.charAt(1) === '"';
            var hasTrailingQuotes = scriptSrc.charAt(scriptSrcLength - 1) === '"' && scriptSrc.charAt(scriptSrcLength - 2) === '"';
            
            // If it has both leading and trailing "", it's not actually running (commented out)
            if (hasLeadingQuotes && hasTrailingQuotes) {
                console.log('[3E Form Validation] Found custom-marketo-validation script but it appears to be commented out (has "" quotes)');
                hasCustomValidation = false; // Don't block execution
            } else {
                // It doesn't have the "" quotes, so it's running
                hasCustomValidation = true;
                console.log('[3E Form Validation] Original hardcoded script detected (custom-marketo-validation in src)');
                break;
            }
        }
    }
    
    if (hasCustomValidation) {
        console.log('[3E Form Validation] Skipping execution - hardcoded script found');
        return;
    }
    
    // Check if older version of the script is already running
    if (window.marketoValidationScriptLoaded) { 
        console.log('[3E Form Validation] Older version detected, skipping execution');
        return;
    }
    
    // Mark this script as loaded to prevent duplicates
    window.marketoValidationScriptLoaded = true;
    
    // Pull configuration from 3E Config variable
    var CFG;
    try { 
        CFG = {{3E config}}; 
    } catch(e) { 
        console.error('[3E Form Validation] Failed to load 3E config:', e);
        CFG = {}; 
    }

    // Configuration options from 3E config with fallbacks
    var enableNameValidation = CFG.formNameValidation === 'true';
    var enableMathQuestion = CFG.formMathValidation === 'true';
    var preventDefaultNames = CFG.formPreventDefaultName === 'true';
    var enableIPBlocking = CFG.formIpBlocking === 'true';
    var enableEduValidation = CFG.formEduValidation === 'true';
    var debugMode = CFG.debugMode === 'true';

    // Log script name and version on load (only in debug mode)
    if (debugMode) {
        console.log('[3E_Form Validation] v7.3.1');
        console.log("3E Form Validation Script Initialized with the following settings:");
        console.log("Enable Name Validation:", enableNameValidation);
        console.log("Enable Math Question Validation:", enableMathQuestion);
        console.log("Prevent Default Names Validation:", preventDefaultNames);
        console.log("Enable IP Blocking Validation:", enableIPBlocking);
        console.log("Enable EDU Email Validation:", enableEduValidation);
        console.log("Debug Mode:", debugMode);
    }

    // Check if the current URL contains "unsub"
    if (window.location.href.toLowerCase().indexOf("unsub") !== -1) {
        if (debugMode) console.log("3E Form Validation: Skipping validation on 'unsub' pages.");
        return; // Exit the script if "unsub" is found in the URL
    }

    // Debug logging function
    function debugLog(message, data) {
        if (debugMode) {
            if (data) {
                console.log('[3E Form Validation]', message, data);
            } else {
                console.log('[3E Form Validation]', message);
            }
        }
    }

    // Global error handler to prevent page refreshes
    window.addEventListener('error', function(event) {
        if (event.message && event.message.indexOf('3E Form Validation') !== -1) {
            debugLog("Global error caught:", event.error);
            event.preventDefault();
            return false;
        }
    });

    // Prevent unhandled promise rejections from causing page refreshes
    window.addEventListener('unhandledrejection', function(event) {
        if (event.reason && event.reason.toString().indexOf('3E Form Validation') !== -1) {
            debugLog("Unhandled promise rejection caught:", event.reason);
            event.preventDefault();
        }
    });

    // Function to ensure MktoForms2 is loaded and form is ready
    function safelyExecuteMkto(callback) {
        if (typeof MktoForms2 !== 'undefined' && MktoForms2.whenReady) {
            MktoForms2.whenReady(callback);
        } else {
            // Retry after a delay if MktoForms2 is not yet available
            debugLog("MktoForms2 not available, retrying...");
            setTimeout(function() {
                safelyExecuteMkto(callback);
            }, 500);
        }
    }

    // Function to inject custom CSS styles
    function addCustomStyles() {
        var style = document.createElement('style');
        style.type = 'text/css';
        style.innerHTML = 
            '.mktoCaptchaDisclaimer { padding-top: 15px; padding-bottom: 15px; }' +
            '#form-error-container {' +
                'color: red;' +
                'margin-bottom: 10px;' +
                'background-color: white;' +
                'padding: 10px;' +
                'border-radius: 4px;' +
            '}' +
            '#math-question { pointer-events: auto !important; }' +
            '#math-question.mktoInvalid { border-color: inherit !important; }' +
            '.mktoForm #math-question ~ .mktoError { display: none !important; }' +
            '#math-question + label[for="math-question"], label[for="math-question"] + #math-question { margin-bottom: 10px !important; }' +
            '#math-question { margin-bottom: 10px !important; }';
        document.head.appendChild(style);
    }

    // Function to fetch the user's IP address
    function fetchUserIP() {
        return new Promise(function(resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', 'https://api.ipify.org?format=json', true);
            xhr.onreadystatechange = function() {
                if (xhr.readyState === 4) {
                    if (xhr.status === 200) {
                        try {
                            var data = JSON.parse(xhr.responseText);
                            resolve(data.ip);
                        } catch (error) {
                            console.error("Error parsing IP response:", error);
                            resolve(null);
                        }
                    } else {
                        console.error("Error fetching IP address:", xhr.status);
                        resolve(null);
                    }
                }
            };
            xhr.onerror = function() {
                console.error("Error fetching IP address: Network error");
                resolve(null);
            };
            xhr.send();
        });
    }

    // Function to fetch blocked IP addresses from Google Sheets
    function fetchBlockedIPs() {
        return new Promise(function(resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', 'https://docs.google.com/spreadsheets/d/e/2PACX-1vQY0866rYIoy160-tNe-wAvH_ryqX3R5ElFNren-jrvLdgjRbHUKEFTEDaaALmjkdRWHpyu3E6f_v39/pub?output=csv', true);
            xhr.onreadystatechange = function() {
                if (xhr.readyState === 4) {
                    if (xhr.status === 200) {
                        try {
                            var text = xhr.responseText;
                            var ips = text.split("\n");
                            var trimmedIPs = [];
                            for (var i = 0; i < ips.length; i++) {
                                trimmedIPs.push(ips[i].trim());
                            }
                            resolve(trimmedIPs);
                        } catch (error) {
                            console.error("Error parsing blocked IPs:", error);
                            resolve([]);
                        }
                    } else {
                        console.error("Error fetching blocked IP addresses:", xhr.status);
                        resolve([]);
                    }
                }
            };
            xhr.onerror = function() {
                console.error("Error fetching blocked IP addresses: Network error");
                resolve([]);
            };
            xhr.send();
        });
    }

    // Function to check if the user's IP is blocked
    function checkAndBlockIP(form) {
        if (!enableIPBlocking) return;

        fetchUserIP().then(function(userIP) {
            if (!userIP) return;

            fetchBlockedIPs().then(function(blockedIPs) {
                var isBlocked = false;
                for (var i = 0; i < blockedIPs.length; i++) {
                    if (blockedIPs[i] === userIP) {
                        isBlocked = true;
                        break;
                    }
                }
                
                if (isBlocked) {
                    // Disable form and show error if IP is blocked
                    disableFormWithError(form, "This form cannot be submitted at this time.");
                    debugLog("User's IP is blocked:", userIP);
                }
            });
        });
    }

    // Function to validate .edu email domain
    function validateEduEmail(email) {
        if (!enableEduValidation) return true; // Skip validation if disabled
        
        if (!email || typeof email !== 'string') return false;
        
        // Check if email ends with .edu (case insensitive)
        var isEduEmail = email.toLowerCase().endsWith('.edu');
        debugLog("EDU email validation:", { email: email, isValid: isEduEmail });
        return isEduEmail;
    }

    // Function to disable the form and display an error message
    function disableFormWithError(form, message) {
        form.getFormElem().find("button.mktoButton").attr("disabled", true);
        displayErrors(form.getFormElem()[0], [message]);
    }

    // Function to generate a random math question with numbers between 1 and 5
    function generateMathQuestion() {
        var num1 = Math.floor(Math.random() * 5) + 1;
        var num2 = Math.floor(Math.random() * 5) + 1;
        var correctAnswer = num1 + num2;
        var wrongAnswers = [correctAnswer + 1, correctAnswer - 1, correctAnswer + 2];
        var options = wrongAnswers.concat([correctAnswer]);

        // Shuffle the options array
        for (var i = options.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var temp = options[i];
            options[i] = options[j];
            options[j] = temp;
        }

        return {
            question: "What is " + num1 + " + " + num2 + "?",
            options: options,
            correctAnswer: correctAnswer.toString()
        };
    }


    // Function to add the math question field to the form (simplified version matching original)
    function addMathQuestionField(form) {
        if (!enableMathQuestion) {
            debugLog("Math question validation disabled, skipping field creation");
