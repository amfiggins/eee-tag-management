        }

        var formElement = form.getFormElem()[0];
        
        // Check if math question field already exists (prevent duplicates from footer script)
        var existingMathQuestion = document.getElementById('math-question');
        if (existingMathQuestion) {
            debugLog("Math question field already exists, skipping creation to prevent duplicates");
            return;
        }

        debugLog("Adding math question field to form");
        var mathQuestion = generateMathQuestion();
        debugLog("Generated math question:", mathQuestion);
        
        // Check if labels are hidden by looking at existing Marketo labels
        var existingLabel = formElement.querySelector('label.mktoLabel');
        var labelsAreHidden = false;
        
        if (existingLabel) {
            var labelStyles = window.getComputedStyle(existingLabel);
            var displayValue = labelStyles.display || '';
            var visibilityValue = labelStyles.visibility || '';
            labelsAreHidden = displayValue === 'none' || visibilityValue === 'hidden';
            debugLog("Label visibility check:", { display: displayValue, visibility: visibilityValue, labelsAreHidden: labelsAreHidden });
        }

        var selectField = document.createElement('select');
        selectField.id = 'math-question';
        // Don't set a name attribute at all - this prevents Marketo from including it in the submission
        selectField.style = "width: 100%;";

        var defaultOption = document.createElement('option');
        defaultOption.value = '';
        
        // When labels are hidden, show the math question in the placeholder
        // When labels are visible, just show "Select the answer"
        if (labelsAreHidden) {
            defaultOption.textContent = mathQuestion.question + ' Select the answer';
        } else {
            defaultOption.textContent = 'Select the answer';
        }
        selectField.appendChild(defaultOption);

        for (var i = 0; i < mathQuestion.options.length; i++) {
            var optionElement = document.createElement('option');
            optionElement.value = mathQuestion.options[i];
            optionElement.textContent = mathQuestion.options[i];
            selectField.appendChild(optionElement);
        }

        // Create a simple label without Marketo classes
        var label = document.createElement('label');
        label.setAttribute('for', 'math-question');
        label.innerHTML = '<span style="color: red; font-weight: bold;">*</span> <strong>' + mathQuestion.question + '</strong>';
        
        // Find an existing Marketo field to copy styles from
        var existingField = formElement.querySelector('select.mktoField, input.mktoField');
        var existingLabel = formElement.querySelector('label.mktoLabel');
        
        // Copy computed styles from existing Marketo elements and apply them
        if (existingLabel) {
            var labelStyles = window.getComputedStyle(existingLabel);
            // Copy all important visual properties
            label.style.fontFamily = labelStyles.fontFamily;
            label.style.fontSize = labelStyles.fontSize;
            label.style.fontWeight = labelStyles.fontWeight;
            label.style.color = labelStyles.color;
            label.style.lineHeight = labelStyles.lineHeight;
            label.style.margin = labelStyles.margin;
            label.style.marginTop = labelStyles.marginTop;
            label.style.marginBottom = labelStyles.marginBottom;
            label.style.padding = labelStyles.padding;
            label.style.display = labelStyles.display;
            label.style.width = labelStyles.width;
        }
        
        // Copy computed styles to select field from existing Marketo fields
        if (existingField) {
            var fieldStyles = window.getComputedStyle(existingField);
            selectField.style.fontFamily = fieldStyles.fontFamily;
            selectField.style.fontSize = fieldStyles.fontSize;
            selectField.style.fontWeight = fieldStyles.fontWeight;
            selectField.style.color = fieldStyles.color;
            selectField.style.lineHeight = fieldStyles.lineHeight;
            selectField.style.height = fieldStyles.height;
            selectField.style.border = fieldStyles.border;
            selectField.style.borderColor = fieldStyles.borderColor;
            selectField.style.borderWidth = fieldStyles.borderWidth;
            selectField.style.borderStyle = fieldStyles.borderStyle;
            selectField.style.borderRadius = fieldStyles.borderRadius;
            selectField.style.padding = fieldStyles.padding;
            selectField.style.paddingTop = fieldStyles.paddingTop;
            selectField.style.paddingRight = fieldStyles.paddingRight;
            selectField.style.paddingBottom = fieldStyles.paddingBottom;
            selectField.style.paddingLeft = fieldStyles.paddingLeft;
            selectField.style.margin = fieldStyles.margin;
            selectField.style.marginTop = fieldStyles.marginTop;
            selectField.style.marginBottom = fieldStyles.marginBottom;
            selectField.style.backgroundColor = fieldStyles.backgroundColor;
        }

        // Detect if labels are positioned below fields by checking form structure
        var testLabel = formElement.querySelector('label.mktoLabel');
        var testInput = formElement.querySelector('input.mktoField, select.mktoField');
        var labelsBelowFields = false;
        
        if (testLabel && testInput) {
            // Check if the label comes after the input in DOM order
            var labelIndex = Array.from(formElement.children).indexOf(testLabel);
            var inputIndex = Array.from(formElement.children).indexOf(testInput);
            labelsBelowFields = labelIndex > inputIndex;
            debugLog("Label position check:", { labelsBelowFields: labelsBelowFields, labelIndex: labelIndex, inputIndex: inputIndex });
        }
        
        var captchaDisclaimer = formElement.querySelector('.mktoCaptchaDisclaimer');
        var submitButton = formElement.querySelector('button.mktoButton');

        // Insert the math question field in the correct order based on form design
        if (labelsBelowFields) {
            // Labels below fields: insert field first, then label
            if (captchaDisclaimer) {
                formElement.insertBefore(selectField, captchaDisclaimer);
                formElement.insertBefore(label, captchaDisclaimer);
            } else if (submitButton) {
                formElement.insertBefore(selectField, submitButton);
                formElement.insertBefore(label, submitButton);
            }
        } else {
            // Labels above fields: insert label first, then field
            if (captchaDisclaimer) {
                formElement.insertBefore(label, captchaDisclaimer);
                formElement.insertBefore(selectField, captchaDisclaimer);
            } else if (submitButton) {
                formElement.insertBefore(label, submitButton);
                formElement.insertBefore(selectField, submitButton);
            }
        }

        form.correctAnswer = mathQuestion.correctAnswer;
        window.marketoCorrectAnswer = mathQuestion.correctAnswer;
        debugLog("Math question field added successfully, correct answer:", form.correctAnswer);
    }

    // Function to display error messages at the top of the form
    function displayErrors(formElement, errors) {
        var errorContainer = document.getElementById('form-error-container');
        
        if (!errorContainer) {
            errorContainer = document.createElement('div');
            errorContainer.id = 'form-error-container';
            formElement.insertBefore(errorContainer, formElement.firstChild);
        }

        errorContainer.innerHTML = errors.join('<br>');
    }

    // Helper function to check if a form is in the hidden conversion container
    // This function uses multiple detection methods for reliability:
    // 1. Data attributes on the form element itself (most reliable)
    // 2. Container ID check
    // 3. Container class and data attribute check
    function isHiddenConversionForm(form) {
        try {
            var formElem = form.getFormElem && form.getFormElem();
            if (!formElem || !formElem.length) return false;
            
            var nativeForm = formElem[0];
            if (!nativeForm) return false;
            
            // METHOD 1: Check data attributes on the form element itself (most reliable)
            // The conversion script sets these attributes directly on the form
            var formType = nativeForm.getAttribute('data-mkto-form-type');
            var formPurpose = nativeForm.getAttribute('data-mkto-form-purpose');
            if (formType === 'hidden-conversion' || formPurpose === 'hidden-conversion') {
                debugLog("Skipping hidden conversion form (via form data attributes):", nativeForm.id || 'no-id');
                return true;
            }
            
            // METHOD 2: Check if form is in the hidden conversion container by ID
            var hiddenContainer = document.getElementById('mkto-hidden-form-conversion');
            if (hiddenContainer && hiddenContainer.contains(nativeForm)) {
                debugLog("Skipping hidden conversion form (via container ID):", nativeForm.id || 'no-id');
                return true;
            }
            
            // METHOD 3: Check via closest() method if available
            if (nativeForm.closest && nativeForm.closest('#mkto-hidden-form-conversion')) {
                debugLog("Skipping hidden conversion form (via closest ID):", nativeForm.id || 'no-id');
                return true;
            }
            
            // METHOD 4: Check for data attribute on container
            var container = nativeForm.closest ? nativeForm.closest('.mkto-hidden-form-container') : null;
            if (container && container.getAttribute('data-mkto-form-purpose') === 'hidden-conversion') {
                debugLog("Skipping hidden conversion form (via container data attribute):", nativeForm.id || 'no-id');
                return true;
            }
            
            return false;
        } catch (e) {
            debugLog("Error checking if form is hidden:", e);
            return false;
        }
    }

    // Function to set up form validation
    function setupFormValidation() {
        safelyExecuteMkto(function(form) {
            // CRITICAL: Skip hidden conversion forms - they should be handled by their own script
            if (isHiddenConversionForm(form)) {
                debugLog("Skipping validation setup for hidden conversion form");
                return;
            }
            
            // Check again at this point if the hardcoded script has already added a math question
            var existingMathQuestion = document.getElementById('math-question');
            if (existingMathQuestion && existingMathQuestion.name === 'mathQuestion') {
                debugLog("Math question field already exists from hardcoded script - skipping execution");
                return;
            }
            
            debugLog("Setting up form validation");
            addCustomStyles(); // Add custom styles
            checkAndBlockIP(form); // Check IP blocking before other validations
            addMathQuestionField(form);

            // Set up form validation (like the old working script)
            if (form && typeof form.onValidate === 'function') {
                form.onValidate(function() {
                    var errors = [];
                    
                    // Normalize names by converting to lowercase and removing spaces
                    var firstName = (form.vals().FirstName || '').toLowerCase().replace(/\s+/g, '');
                    var lastName = (form.vals().LastName || '').toLowerCase().replace(/\s+/g, '');
                    var email = (form.vals().Email || '');

                    // Check if name validation is enabled and the names are the same
                    if (enableNameValidation && firstName === lastName) {
                        errors.push('First Name and Last Name cannot be the same.');
                    }

                    // Check if preventDefaultNames validation is enabled
                    if (preventDefaultNames) {
                        if (firstName.includes("first")) {
                            errors.push('The First Name cannot contain "first".');
                        }
                        if (lastName.includes("last")) {
                            errors.push('The Last Name cannot contain "last".');
                        }
                    }

                    // Validate .edu email domain if enabled
                    if (enableEduValidation && email) {
                        if (!validateEduEmail(email)) {
                            errors.push('Email must be a .edu address.');
                        }
                    }

                    // Validate the math question if enabled
                    if (enableMathQuestion) {
                        var mathQuestionElement = document.getElementById('math-question');
                        if (mathQuestionElement) {
                            var selectedAnswer = mathQuestionElement.value;
                            var correctAnswer = form.correctAnswer || window.marketoCorrectAnswer;
                            if (!selectedAnswer || !correctAnswer || selectedAnswer !== correctAnswer) {
                                errors.push('Please answer the math question correctly.');
                            }
                        }
                    }

                    // Display errors if any, otherwise allow form submission (like the old script - no return)
                    if (errors.length > 0) {
                        displayErrors(form.getFormElem()[0], errors);
                        form.submittable(false);
                    } else {
                        form.submittable(true);
                    }
                });
            }

            // Additional validation on submit (commented out to let Marketo handle submission)
            // The onValidate handler above should be sufficient
            /* if (form && typeof form.onSubmit === 'function') {
                form.onSubmit(function() {
                try {
                    var errors = [];
                    var formValues = form.vals();
                    
                    // Normalize names by converting to lowercase and removing spaces
                    var firstName = (formValues.FirstName || '').toLowerCase().replace(/\s+/g, '');
                    var lastName = (formValues.LastName || '').toLowerCase().replace(/\s+/g, '');
                    var email = formValues.Email || '';

                    // Check if name validation is enabled and the names are the same
                    if (enableNameValidation && firstName === lastName) {
                        errors.push('First Name and Last Name cannot be the same.');
                    }

                    // Check if preventDefaultNames validation is enabled
                    if (preventDefaultNames) {
                        if (firstName.includes("first")) {
                            errors.push('The First Name cannot contain "first".');
                        }
                        if (lastName.includes("last")) {
                            errors.push('The Last Name cannot contain "last".');
                        }
                    }

                    // Validate .edu email domain if enabled
                    if (enableEduValidation && email) {
                        if (!validateEduEmail(email)) {
                            errors.push('Email must be a .edu address.');
                        }
                    }

                    // Validate the math question if enabled
                    if (enableMathQuestion) {
                        var mathQuestionElement = document.getElementById('math-question');
                        if (mathQuestionElement) {
                            var selectedAnswer = mathQuestionElement.value;
                            var correctAnswer = form.correctAnswer || window.marketoCorrectAnswer;
                            if (!selectedAnswer || !correctAnswer || selectedAnswer !== correctAnswer) {
                                errors.push('Please answer the math question correctly.');
                            }
                        } else {
                            debugLog("Math question element not found in onSubmit, skipping validation");
                        }
                    }

                    // If there are errors, prevent submission and show them
                    if (errors.length > 0) {
                        displayErrors(form.getFormElem()[0], errors);
                        return false; // Prevent form submission
                    }

                    return true; // Allow form submission
                } catch (error) {
                    debugLog("Error in onSubmit validation:", error);
                    // If there's an error, let the form submit normally
                    return true;
                }
                });
            } else {
                debugLog("Form object or onSubmit method not available");
            } */

            // CRITICAL: Only set up onSuccess for visible forms, not hidden conversion forms
            // Hidden forms have their own onSuccess handlers that prevent navigation
            if (form && typeof form.onSuccess === 'function' && !isHiddenConversionForm(form)) {
                form.onSuccess(function(values, followUpUrl) {
                    try {
                        debugLog("Form submitted successfully", values);
                        
                        if (typeof dataLayer !== 'undefined') {
                            dataLayer.push({ 'event': 'rfi_submission' });
                            debugLog("RFI submission event pushed to dataLayer");
                        }

                        if (followUpUrl) {
                            debugLog("Redirecting to follow-up URL:", followUpUrl);
                            window.location.href = followUpUrl;
                        }

                        return false; // Prevent default Marketo redirect
                    } catch (error) {
                        debugLog("Error in onSuccess handler:", error);
                        return false;
                    }
                });
            } else if (isHiddenConversionForm(form)) {
                debugLog("Skipping onSuccess setup for hidden conversion form - handled by its own script");
            } else {
                debugLog("Form object or onSuccess method not available");
            }
        });
    }

    // Initialize the form validation setup
    debugLog("Initializing 3E Form Validation");
    
    if (window.MktoForms2) {
        debugLog("MktoForms2 already available, setting up validation");
        setupFormValidation();
    } else {
        debugLog("MktoForms2 not available, waiting for MktoForms2Loaded event");
        window.addEventListener('MktoForms2Loaded', function() {
            debugLog("MktoForms2Loaded event received, setting up validation");
            setupFormValidation();
        });
    }
})();
</script>