<script>
// Script Name: 3E Pop-up Tracking
// Author: Anthony Figgins
// Description: Tracks Digioh popup interactions, enriches dataLayer events, and forwards activity to Marketo Munchkin.
// Version: 2.3.2
// Date Updated: 2025-09-26
// Dependencies: 3E Config, Marketo Munchkin

(function() {
  // Get debug mode from 3E Config
  var CFG;
  try { 
    CFG = {{3E config}}; 
  } catch(e) { 
    CFG = {}; 
  }
  var DEBUG = CFG && CFG.debugMode === 'true';

  // Log script name and version on load (only in debug mode)
  if (DEBUG) {
    console.log('[3E_Pop-up Tracking] v2.3.2');
  }

  // Supported events categorized by activity type
  var clickEvents = ['DigiohSubmit', 'DigiohRedirect', 'DigiohClose', 'DigiohDownload'];
  var pageViewEvents = ['DigiohDisplay'];

  // Function to get current Eastern Standard Time (EST)
  function getEasternTimestamp() {
    var now = new Date();
    var utcOffset = now.getTimezoneOffset() * 60000; // Convert minutes to milliseconds
    var easternOffset = -5 * 3600000; // EST is UTC-5
    var easternTime = new Date(now.getTime() + utcOffset + easternOffset);
    return easternTime.toISOString().replace('T', '_').split('.')[0]; // Format: YYYY-MM-DD_HH:MM:SS
  }

  // Function to process incoming events
  function processDigiohEvent(eventData) {
    if (!eventData || !eventData.event || 
        (clickEvents.indexOf(eventData.event) === -1 && pageViewEvents.indexOf(eventData.event) === -1)) {
      console.warn('Invalid or unsupported event data:', eventData);
      return;
    }

    var eventName = eventData.event;
    var uniqueEventId = eventData['gtm.uniqueEventId'] || null;
    var boxName = eventData.DigiohBoxName || 'UnknownBox';
    var timestamp = getEasternTimestamp(); // Generate EST timestamp
    var combinedId = uniqueEventId + '_' + timestamp.replace(/:/g, ''); // Combine uniqueEventId and sanitized timestamp

    if (!uniqueEventId) {
      console.error('Missing uniqueEventId in event data:', eventData);
      return;
    }

    // Push enhanced event back to dataLayer
    var enhancedEvent = {
      event: 'Enhanced' + eventName,
      originalEvent: eventName,
      DigiohBoxName: boxName,
      timestamp: timestamp,
      uniqueEventId: uniqueEventId,
      combinedId: combinedId
    };
    window.dataLayer.push(enhancedEvent);

    console.log('Processed and pushed enhanced event:', enhancedEvent);

    // Prepare Marketo tracking data
    var marketoParams = {
      action: eventName,
      boxName: boxName,
      formattedBoxName: boxName.replace(/\s+/g, '_'), // Replace spaces with underscores
      paramsString: eventName + '=' + boxName.replace(/\s+/g, '_') + '&id=' + combinedId
    };

    // Send activity to Marketo
    if (typeof Munchkin !== 'undefined' && Munchkin.munchkinFunction) {
      if (clickEvents.indexOf(eventName) !== -1) {
        // For click events
        console.log('Sending clickLink activity to Marketo:', marketoParams);
        Munchkin.munchkinFunction('clickLink', {
          href: '/popup?' + marketoParams.paramsString
        });
      } else if (pageViewEvents.indexOf(eventName) !== -1) {
        // For page view events
        console.log('Sending visitWebPage activity to Marketo:', marketoParams);
        Munchkin.munchkinFunction('visitWebPage', {
          url: '/popup',
          params: marketoParams.paramsString
        });
      }
    } else {
      console.warn('Marketo Munchkin is not loaded or unavailable.');
    }
  }

  // Check if GTM provided event data
  if (window.dataLayer && window.dataLayer[window.dataLayer.length - 1]) {
    var latestEvent = window.dataLayer[window.dataLayer.length - 1];
    processDigiohEvent(latestEvent);
  } else {
    console.warn('No event data found in dataLayer');
  }
})();
</script>
