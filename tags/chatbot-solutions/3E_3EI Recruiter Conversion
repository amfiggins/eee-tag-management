<script>
// Script Name: 3E_3EI Recruiter Conversion
// Author: Anthony Figgins
// Description: Submits a hidden Marketo blind form on 3EI Recruiter email capture using 3E config; lazy-loads Forms2 and ensures tracking cookie.
// Version: 2.4.0
// Date Updated: 2025-12-19
// Dependencies: 3E Config, Marketo Forms2
// Changes: Refactored for better isolation, removed global interceptors, added priority onSuccess handler

(function () {
  'use strict';
  // === Pull config once ===
  var CFG;
  try { 
    CFG = {{3E config}}; 
  } catch(e) { 
    CFG = {}; 
  }

  // --- Marketo values ---
  var MKTO_BASE_RAW = CFG && CFG.baseUrl ? String(CFG.baseUrl).trim() : '';
  // Normalize baseUrl - ensure protocol-relative format (//domain.com)
  // Remove http:// or https:// if present, remove trailing slashes, then add //
  var MKTO_BASE = '';
  if (MKTO_BASE_RAW) {
    MKTO_BASE = MKTO_BASE_RAW
      .replace(/^https?:\/\//, '') // Remove http:// or https://
      .replace(/\/+$/, '') // Remove trailing slashes
      .replace(/^\/+/, ''); // Remove leading slashes
    if (MKTO_BASE) {
      MKTO_BASE = '//' + MKTO_BASE; // Add protocol-relative prefix
    }
  }
  var MKTO_ID      = CFG && CFG.munchkinId ? String(CFG.munchkinId).trim() : '';
  var MKTO_DEBUG = CFG && CFG.debugMode === 'true';
  var MKTO_FORM_ID = CFG && CFG.blindFormId ? String(CFG.blindFormId).trim() : '';

  // --- Chatbot values (not used here, but available) ---
  var CHATBOT_PROD = CFG && CFG.chatBotProdId ? CFG.chatBotProdId : '';
  var CHATBOT_DEV  = CFG && CFG.chatBotDevId ? CFG.chatBotDevId : '';

  // Log script name and version on load (only in debug mode)
  if (MKTO_DEBUG) {
    console.log('[3E_ChatBot Conversion] v2.4.0');
  }

  // === Validate required config values ===
  if (!MKTO_BASE) {
    if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] Missing baseUrl in 3E config');
    return;
  }
  if (!MKTO_ID) {
    if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] Missing munchkinId in 3E config');
    return;
  }
  if (!MKTO_FORM_ID) {
    if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] Missing blindFormId in 3E config');
    return;
  }

  // === DataLayer event ===
  var ev = (window.dataLayer && window.dataLayer.length)
    ? window.dataLayer[window.dataLayer.length - 1]
    : {};

  if (!ev || ev.event !== 'bot_email_captured' || !ev.details || !ev.details.email) {
    if (MKTO_DEBUG) console.log('[3E_ChatBot Conversion] No bot_email_captured event found');
    return;
  }

  var email = String(ev.details.email || '').trim();
  if (!email) {
    if (MKTO_DEBUG) console.warn('[3E_ChatBot Conversion] Email is empty');
    return;
  }

  // === Check for existing Marketo forms on the page ===
  var existingForms = document.querySelectorAll('form.mktoForm, form[id^="mktoForm_"]');
  var hasOtherForms = existingForms.length > 0;
  if (hasOtherForms && MKTO_DEBUG) {
    console.log('[3E_ChatBot Conversion] Detected', existingForms.length, 'existing Marketo form(s) on page. Our hidden form will be isolated.');
  }

  // === Ensure hidden form container (unique and isolated) ===
  var ctr = document.getElementById('mkto-hidden-form-conversion');
  if (!ctr) {
    ctr = document.createElement('div');
    ctr.id = 'mkto-hidden-form-conversion';
    ctr.className = 'mkto-hidden-form-container';
    ctr.style.display = 'none';
    ctr.setAttribute('data-mkto-form-purpose', 'hidden-conversion');
    // Ensure body exists before appending
    if (document.body) {
      document.body.appendChild(ctr);
    } else {
      // Wait for DOM to be ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          document.body.appendChild(ctr);
        });
      } else {
        // Fallback: append to documentElement
        document.documentElement.appendChild(ctr);
      }
    }
  }
  
  // Ensure container is connected to DOM
  if (ctr && !document.body.contains(ctr) && !document.documentElement.contains(ctr)) {
    if (document.body) {
      document.body.appendChild(ctr);
    } else if (document.documentElement) {
      document.documentElement.appendChild(ctr);
    }
  }

  // === Loader for Forms2 ===
  function loadForms2(cb, errCb) {
    if (window.MktoForms2) { 
      cb(); 
      return; 
    }
    var s = document.createElement('script');
    s.async = true;
    s.src = MKTO_BASE + '/js/forms2/js/forms2.min.js';
    s.onload = function() {
      if (window.MktoForms2) {
        cb();
      } else {
        if (errCb) errCb(new Error('MktoForms2 not available after script load'));
        else if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] MktoForms2 not available after script load');
      }
    };
    s.onerror = function() {
      var err = new Error('Failed to load Marketo Forms2 script from ' + s.src);
      if (errCb) errCb(err);
      else if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion]', err);
    };
    document.head.appendChild(s);
  }

  // === Ensure tracking cookie (optional) ===
  try {
    if (window.Munchkin && Munchkin.createTrackingCookie) {
      Munchkin.createTrackingCookie(true);
    }
  } catch (e) {
    if (MKTO_DEBUG) console.warn('[Munchkin cookie]', e);
  }

  // === Submit hidden form ===
  loadForms2(
    function () {
      if (!window.MktoForms2) {
        if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] MktoForms2 is not available');
        return;
      }

      if (MKTO_DEBUG) {
        console.log('[3E_ChatBot Conversion] Loading form with config:', {
          baseUrl: MKTO_BASE,
          munchkinId: MKTO_ID,
          formId: MKTO_FORM_ID,
          email: email,
          forms2ScriptUrl: MKTO_BASE + '/js/forms2/js/forms2.min.js'
        });
      }

      // Set a timeout to detect if form never loads
      var formLoadTimeout = setTimeout(function() {
        if (MKTO_DEBUG) {
          console.error('[3E_ChatBot Conversion] Form load timeout - form may not exist or IDs are incorrect');
          console.error('[3E_ChatBot Conversion] Verify form ID', MKTO_FORM_ID, 'exists in Marketo instance', MKTO_BASE);
        }
      }, 10000); // 10 second timeout

      try {
        // Convert form ID to number if it's a string (Marketo accepts both)
        var formIdNum = parseInt(MKTO_FORM_ID, 10);
        if (isNaN(formIdNum)) {
          if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] Invalid form ID (not a number):', MKTO_FORM_ID);
          return;
        }

        // Load form into the hidden container
        window.MktoForms2.loadForm(
          MKTO_BASE, 
          MKTO_ID, 
          formIdNum, 
          function (form) {
            clearTimeout(formLoadTimeout);

            // Validate form object
            if (!form) {
              if (MKTO_DEBUG) {
                console.error('[3E_ChatBot Conversion] Form object is null or undefined');
                console.error('[3E_ChatBot Conversion] This usually means the form ID is invalid or the form does not exist');
                console.error('[3E_ChatBot Conversion] Verify form ID', formIdNum, 'exists in Marketo instance', MKTO_BASE, 'with munchkin ID', MKTO_ID);
              }
              return;
            }

            if (MKTO_DEBUG) console.log('[3E_ChatBot Conversion] Form loaded successfully');

            // Get form element for verification
            var formElem = form.getFormElem && form.getFormElem();
            var nativeForm = formElem && formElem.length ? formElem[0] : null;
            
            if (MKTO_DEBUG && nativeForm) {
              console.log('[3E_ChatBot Conversion] Form ID:', nativeForm.id || 'no-id');
              console.log('[3E_ChatBot Conversion] Form container verified');
            }

            if (MKTO_DEBUG) console.log('[3E_ChatBot Conversion] Setting up handlers for our isolated form instance');
            
            // CRITICAL: Set up onSuccess handler immediately to prevent any navigation/redirect
            // Form Validation will skip this hidden form (see 3E_Form Validation script),
            // so our handler will be the only one or will run first if somehow another handler exists
            // Returning false prevents default Marketo redirect behavior
            form.onSuccess(function (values, followUpUrl) {
              if (MKTO_DEBUG) {
                console.log('[3E_ChatBot Conversion] Hidden form submitted successfully:', email);
                if (followUpUrl) {
                  console.log('[3E_ChatBot Conversion] Follow-up URL prevented:', followUpUrl);
                }
              }
              
              // Return false to prevent any navigation/redirect
              // This prevents the page from reloading or redirecting after form submission
              return false;
            });
            
            if (MKTO_DEBUG) {
              console.log('[3E_ChatBot Conversion] onSuccess handler registered to prevent page reload');
            }

            // Set followUpUrl to current page as additional safeguard
            try {
              if (form.setFollowUpUrl) {
                form.setFollowUpUrl(window.location.href);
                if (MKTO_DEBUG) console.log('[3E_ChatBot Conversion] Set followUpUrl to current page');
              }
            } catch (e) {
              if (MKTO_DEBUG) console.warn('[3E_ChatBot Conversion] Could not set followUpUrl:', e);
            }

            // Modify form attributes to prevent navigation
            try {
              if (nativeForm) {
                nativeForm.setAttribute('action', 'javascript:void(0)');
                nativeForm.setAttribute('target', '_self');
                if (MKTO_DEBUG) console.log('[3E_ChatBot Conversion] Modified form action to prevent navigation');
              }
            } catch (e) {
              if (MKTO_DEBUG) console.warn('[3E_ChatBot Conversion] Could not modify form element:', e);
            }

            // Handle form errors
            if (form.onError) {
              form.onError(function (error) {
                if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] Form submission error:', error);
              });
            }

            // Set form values
            try {
              form.vals({ Email: email });
              if (MKTO_DEBUG) console.log('[3E_ChatBot Conversion] Email set in form:', email);
            } catch (e) {
              if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] Error setting form values:', e);
              return;
            }

            // Ensure form is in DOM before submitting
            // Marketo's loadForm callback should have already attached it to our container
            // But we verify and wait if needed
            var submitAttempts = 0;
            var maxSubmitAttempts = 30; // 3 seconds max (30 * 100ms)
            
            function attemptSubmit() {
              submitAttempts++;
              var formElement = form.getFormElem && form.getFormElem();
              var nativeFormElement = formElement && formElement.length ? formElement[0] : null;
              var formInDOM = false;
              
              if (nativeFormElement) {
                // Check if form is in DOM
                if (nativeFormElement.isConnected !== undefined) {
                  formInDOM = nativeFormElement.isConnected;
                } else {
                  // Fallback check
                  try {
                    formInDOM = document.body.contains(nativeFormElement) || 
                               document.documentElement.contains(nativeFormElement) ||
                               (ctr && ctr.contains && ctr.contains(nativeFormElement));
                  } catch(e) {
                    formInDOM = false;
                  }
                }
              }
              
              // If form not in DOM yet, wait a bit more
              if (!formInDOM && submitAttempts < maxSubmitAttempts) {
                setTimeout(attemptSubmit, 100);
                return;
              }
              
              // Submit the form
              try {
                if (MKTO_DEBUG) {
                  console.log('[3E_ChatBot Conversion] Submitting hidden form for:', email);
                }
                form.submit();
              } catch (e) {
                if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] Error submitting form:', e);
              }
            }
            
            // Start submission attempt after a small delay to ensure everything is set up
            setTimeout(attemptSubmit, 200);
          },
          ctr // Specify the container element for the hidden form
        );
      } catch (e) {
        clearTimeout(formLoadTimeout);
        if (MKTO_DEBUG) {
          console.error('[3E_ChatBot Conversion] Exception loading form:', e);
          console.error('[3E_ChatBot Conversion] Config values:', {
            baseUrl: MKTO_BASE,
            munchkinId: MKTO_ID,
            formId: MKTO_FORM_ID
          });
        }
      }
    },
    function (err) {
      if (MKTO_DEBUG) console.error('[3E_ChatBot Conversion] Failed to load Forms2 script:', err);
    }
  );
})();
</script>