<script>
// Script Name: 3E_3EI Recruiter Activity
// Author: Anthony Figgins
// Description: Captures 3EI Recruiter activity signals from iframe postMessage and pushes them to the GTM dataLayer.
// Version: 1.1.9
// Date Updated: 2025-09-26
// Dependencies: 3E Config

  window.dataLayer = window.dataLayer || [];

  (function () {
    'use strict';
    // Get debug mode from 3E Config
    var CFG;
    try { 
      CFG = {{3E config}}; 
    } catch(e) { 
      CFG = {}; 
    }
    var DEBUG = CFG && CFG.debugMode === 'true';

    // Log script name and version on load (only in debug mode)
    if (DEBUG) {
      console.log('[3E_ChatBot Activity] v1.1.9');
    }
    var allowed = {
      'bot_initiated': 1,
      'bot_response': 1,
      'bot_click_link': 1,
      'bot_click_app_link': 1,
      'bot_engagement': 1,
      'bot_closed': 1,
      'bot_email_captured': 1
    };

    window.addEventListener('message', function (e) {
      var p = e.data;
      if (!p || typeof p !== 'object') return;
      var t = String(p.type || '');
      if (t.indexOf('bot_') !== 0 || !allowed[t]) return;

      if (DEBUG) console.log('[PARENT RECEIVED]', t, p);

      window.dataLayer.push({
        event: t,
        botId: p.botId || null,
        timestamp: p.timestamp || Date.now(),
        details: p.details || null,
        source: 'iframe_postMessage'
      });
    });
  })();
</script>