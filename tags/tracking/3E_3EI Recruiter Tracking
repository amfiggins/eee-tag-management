<script>
// Script Name: 3E_3EI Recruiter Tracking
// Author: Anthony Figgins
// Description: Forwards 3EI Recruiter GTM events to Marketo Munchkin as visit/click activities.
// Version: 2.1.4
// Date Updated: 2025-09-26
// Dependencies: 3E Config, Marketo Munchkin

  window.dataLayer = window.dataLayer || [];

  (function () {
    'use strict';
    // Get debug mode from 3E Config
    var CFG;
    try { 
      CFG = {{3E config}}; 
    } catch(e) { 
      CFG = {}; 
    }
    var DEBUG = CFG && CFG.debugMode === 'true';

    // Log script name and version on load (only in debug mode)
    if (DEBUG) {
      console.log('[3E_ChatBot Tracking] v2.1.4');
    }

    // Get the most recent dataLayer event
    var ev = (window.dataLayer && window.dataLayer.length)
      ? window.dataLayer[window.dataLayer.length - 1]
      : {};

    var allowed = {
      'bot_initiated': 1,
      'bot_response': 1,
      'bot_click_link': 1,
      'bot_click_app_link': 1,
      'bot_engagement': 1,
      'bot_closed': 1
    };
    if (!ev || !allowed[ev.event]) return;

    function ts() {
      try {
        var d = new Date();
        var iso = d.toISOString().split('.')[0]; // 2025-09-19T20:12:34
        return iso.replace('T', '_');
      } catch (e) { return ''; }
    }

    var botId = ev.botId || '';
    var href = ev.details && ev.details.href ? String(ev.details.href) : '';
    var uid = (ev['gtm.uniqueEventId'] || Math.floor(Math.random() * 1e9)) + '_' + ts().replace(/:/g, '');
    var params =
      'evt=' + encodeURIComponent(ev.event) +
      '&bot=' + encodeURIComponent(botId) +
      (href ? '&href=' + encodeURIComponent(href) : '') +
      '&id=' + encodeURIComponent(uid);

    if (typeof Munchkin === 'undefined' || !Munchkin.munchkinFunction) return;

    if (DEBUG) { console.log('[BOT→MKTO]', ev.event, { params: params, href: href }); }

    var isVisit = ev.event === 'bot_initiated' || ev.event === 'bot_engagement' || ev.event === 'bot_closed';

    if (isVisit) {
      Munchkin.munchkinFunction('visitWebPage', { url: '/bot-activity', params: params });
    } else {
      Munchkin.munchkinFunction('clickLink', { href: '/bot-click?' + params });
    }
  })();
</script>
